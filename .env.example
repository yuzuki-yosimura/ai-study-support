# Groq（https://console.groq.com/keys）
GROQ_API_KEY=

# 任意。未設定時は llama-3.1-8b-instant
# GROQ_MODEL=llama-3.1-8b-instant

# PostgreSQL（例: ホストで npm run dev し、Compose の DB のポートを開けている場合）
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_study_support?schema=public"

# Docker Compose の app からは compose が DATABASE_URL を上書きするため、ここは未設定でも可。
# Vercel / Neon 等はダッシュボードの接続文字列（?sslmode=require が付くこともある）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_study_support?schema=public"
