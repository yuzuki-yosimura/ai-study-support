datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model QuizLog {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  correct   Boolean
  createdAt DateTime @default(now())
}

model QuizQuestion {
  id        Int     @id @default(autoincrement())
  question  String
  answer    String
  category  String?
}
